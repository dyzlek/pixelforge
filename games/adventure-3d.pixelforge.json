    {
      "id": "obj_5pu7zn5",
      "name": "Player",
      "spriteId": null,
      "defaultAnim": "idle",
      "hitbox": null,
      "physics": {
        "enabled": true,
        "gravity": true,
        "immovable": false,
        "bounce": 0,
        "collideMap": true,
        "collideWorld": true,
        "bodyType": "dynamic",
        "colliderShape": "box",
        "mass": 1,
        "friction": 0.5,
        "restitution": 0
      },
      "script": {
        "mode": "code",
        "code": "let jumpForce = 12;\nlet moveSpeed = 6;\nlet rotationSpeed = 3;\n\non('create', () => {\n  game.camera.setMode('third-person');\n  game.camera.follow(self, { distance: 7, height: 3.5 });\n  game.score = 0;\n  game.setText('hud', 'Cristaux : ' + game.score + ' / 3', 8, 8);\n  game.setText('info', 'WASD ou Fleches pour bouger, ESPACE pour sauter', 8, 24);\n  game.playSong('AdventureTheme', { loop: true, volume: 0.7 });\n  self.play('idle');\n});\n\non('update', () => {\n  let forward = 0;\n  if (input.isDown('UP') || input.isDown('W') || input.isDown('Z')) forward = moveSpeed;\n  if (input.isDown('DOWN') || input.isDown('S')) forward = -moveSpeed;\n\n  if (input.isDown('LEFT') || input.isDown('A') || input.isDown('Q')) self.rotateY(-rotationSpeed);\n  if (input.isDown('RIGHT') || input.isDown('D')) self.rotateY(rotationSpeed);\n\n  self.moveForward(forward);\n\n  if (forward !== 0) {\n    self.play('walk');\n  } else {\n    self.play('idle');\n  }\n\n  if ((input.justPressed('SPACE') || input.justPressed('UP')) && self.onGround) {\n    self.jump(jumpForce);\n    game.playSound('jump');\n  }\n\n  if (self.y < -15) {\n    game.restart();\n  }\n});\n"
      },
      "exportedProps": [],
      "modelId": "model_5dbyx9x"
    },
    {
      "id": "obj_mtxjduh",
