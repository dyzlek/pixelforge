        "bodyType": "static",
        "colliderShape": "box",
        "mass": 1,
        "friction": 0.5,
        "restitution": 0
      },
      "script": {
        "mode": "code",
        "code": "on('update', () => {\n  self.rotateY(3);\n});\n\non('overlap', 'Player', () => {\n  game.score += 1;\n  game.playSound('coin');\n  game.setText('hud', 'Cristaux : ' + game.score + ' / 3', 8, 8);\n  if (game.score >= 3) {\n    game.setText('info', 'Tous les cristaux sont collectes ! Trouve le coffre !', 8, 24);\n  }\n  self.destroy();\n});\n"
      },
